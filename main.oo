// # oochown Main Entry Point
//
// Logline: Sovereign ownership manager with declarative systemd-tmpfiles synthesis and MCP stdio server.
//
// Setup: Demands explicit capability tokens FsReadCap, ProcessCap, EnvCap.
//
// Beats:
//   1. Parse command-line options and dispatch --help, --version, or --mcp.
//   2. Plan ownership transitions or synthesize declarative systemd-tmpfiles rules.
//   3. Execute bounded ownership updates or render dry-run previews under ProcessCap.
//   4. Deliver POSIX diagnostics or structured JSON telemetry.

import "core/chown_types.oo";
import "core/chown_lookup.oo";
import "core/chown_plan.oo";
import "core/chown_demo.oo";
import "render/chown_theme.oo";
import "ipc/chown_opts.oo";
import "ipc/mcp_serve.oo";

pub fn render_help() -> String {
    return "oochown 0.2.0 (openOODA sovereign files & navigation)\n"
        + "usage: oochown [OPTION]... [OWNER][:[GROUP]] FILE...\n"
        + "  or:  oochown [OPTION]... --reference=RFILE FILE...\n\n"
        + "Change the owner and/or group of each FILE to OWNER and/or GROUP.\n\n"
        + "Options:\n"
        + "  -c, --changes          like verbose but report only when a change is made\n"
        + "  -f, --silent, --quiet  suppress most error messages\n"
        + "  -v, --verbose          output a diagnostic for every file processed\n"
        + "  -R, --recursive        operate on files and directories recursively\n"
        + "      --reference=RFILE  use RFILE's owner and group rather than specifying values\n"
        + "      --dry-run          simulate ownership changes without disk writes\n"
        + "      --tmpfiles         synthesize declarative systemd-tmpfiles rules\n"
        + "      --demo             run demonstration scenarios with synthetic fixtures\n"
        + "      --json             output formatted as JSON Lines\n"
        + "  -h, --help             display this help and exit\n"
        + "  -V, --version          output version information and exit\n"
        + "      --mcp              run as Model Context Protocol stdio server\n";
}

pub fn render_version() -> String {
    return "oochown 0.2.0 (openOODA sovereign files & navigation)\n";
}

pub fn main(
    fs: &FsReadCap,
    proc_cap: &ProcessCap,
    _env: &EnvCap,
    args: List[String]
) -> Result[Int, String] {
    let opts: ChownOpts = parse_chown_opts(args);

    if opts.help_mode {
        print(render_help());
        return Ok(0);
    }
    if opts.version_mode {
        print(render_version());
        return Ok(0);
    }
    if opts.mcp_mode {
        run_mcp_server(fs, proc_cap);
        return Ok(0);
    }

    if opts.demo_mode {
        let demo_targets: List[ChownTarget] = build_demo_targets();
        let demo_sum: ChownSummary = build_demo_summary();

        if opts.tmpfiles_mode {
            let tmp_rules: List[TmpfilesEntry] = build_demo_tmpfiles();
            print(format_tmpfiles_config(tmp_rules));
            return Ok(0);
        }

        if opts.json_mode {
            print(render_json_results(demo_targets, demo_sum, "audit:audit"));
            return Ok(0);
        }

        let n: Int = list_len(demo_targets);
        let mut i: Int = 0;
        while i < n {
            let t: ChownTarget = list_get(demo_targets, i);
            print(render_target_output(t, true, opts.changes_only, opts.quiet));
            i = i + 1;
        }
        return Ok(0);
    }

    let users: List[UserEntry] = load_system_users(fs);
    let groups: List[GroupEntry] = load_system_groups(fs);
    let mut spec: ChownSpec = make_chown_spec("", "", -1, "", -1, false, false);

    if chars_len(opts.reference) > 0 {
        let ref_owner: String = inspect_path_owner(proc_cap, opts.reference);
        let ref_uid: Int = inspect_path_uid(proc_cap, opts.reference);
        let ref_group: String = inspect_path_group(proc_cap, opts.reference);
        let ref_gid: Int = inspect_path_gid(proc_cap, opts.reference);
        spec = make_chown_spec(ref_owner + ":" + ref_group, ref_owner, ref_uid, ref_group, ref_gid, true, true);
    } else if chars_len(opts.spec) > 0 {
        spec = parse_chown_spec(opts.spec, users, groups);
    }

    let num_files: Int = list_len(opts.files);
    if (!spec.has_owner && !spec.has_group) || num_files == 0 {
        print(render_help());
        return Ok(1);
    }

    let mut planned_targets: List[ChownTarget] = list_new();
    let mut i: Int = 0;
    while i < num_files {
        let fpath: String = list_get(opts.files, i);
        let c_owner: String = inspect_path_owner(proc_cap, fpath);
        let c_uid: Int = inspect_path_uid(proc_cap, fpath);
        let c_group: String = inspect_path_group(proc_cap, fpath);
        let c_gid: Int = inspect_path_gid(proc_cap, fpath);

        let planned: ChownTarget = plan_single_chown(fpath, c_owner, c_uid, c_group, c_gid, spec);
        planned_targets = list_push(planned_targets, planned);
        i = i + 1;
    }

    if opts.tmpfiles_mode {
        let tmpfiles_entries: List[TmpfilesEntry] = build_chown_tmpfiles(planned_targets, opts.recursive);
        print(format_tmpfiles_config(tmpfiles_entries));
        return Ok(0);
    }

    let executed_targets: List[ChownTarget] = execute_chown_plan(proc_cap, planned_targets, spec, opts.recursive, opts.dry_run);
    let sum: ChownSummary = summarize_chown_targets(executed_targets);

    if opts.json_mode {
        print(render_json_results(executed_targets, sum, spec.raw));
        if sum.failed > 0 {
            return Ok(1);
        }
        return Ok(0);
    }

    let n: Int = list_len(executed_targets);
    let mut idx: Int = 0;
    while idx < n {
        let t: ChownTarget = list_get(executed_targets, idx);
        print(render_target_output(t, opts.verbose, opts.changes_only, opts.quiet));
        idx = idx + 1;
    }

    print(render_summary_warnings(sum));

    if sum.failed > 0 {
        return Ok(1);
    }
    return Ok(0);
}
